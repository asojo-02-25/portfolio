---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? title + ' | Ao' : 'Ao | Portfolio';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content="Aoのポートフォリオサイト。" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content="Aoのポートフォリオサイト。" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="brand" href={base}>
        Ao
        <span class="brand-dot" aria-hidden="true">
          .
        </span>
      </a>
      <span class="header-label">PORTFOLIO</span>
    </header>
    <main id="main" class="page-wrap min-w-0" tabindex="-1">
      {title && (
        <>
          <a class="back-link" href={base}>
            ‹ Home
          </a>
          <h1 class="page-title">{title}</h1>
        </>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Social links">
        <a
          href="https://github.com/asojo-02-25"
          aria-label="GitHub"
          class="social-link"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            width="24"
            height="24"
          >
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.23c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a11 11 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.08 0 4.43-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.25c0 .31.21.68.79.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
        </a>
        <a
          href="https://x.com/jo_integralis"
          aria-label="X"
          class="social-link"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            width="24"
            height="24"
          >
            <path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-7.42L5.55 22H2.4l7.98-9.12L2.7 2h6.41l4.43 6.77L18.9 2Zm-1.1 18h1.73L8.16 3.89H6.3L17.8 20Z" />
          </svg>
        </a>
      </nav>
    </footer>
  </body>
</html>
