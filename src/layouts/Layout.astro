---
import '../styles/global.css';
interface Props { title?: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? title + ' | Ao' : 'Ao | Portfolio';
---
<!doctype html>
<html lang="ja"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{fullTitle}</title><meta name="description" content="Aoのポートフォリオサイト。" /><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} /></head>
<body><a class="skip-link" href="#main">本文へ移動</a><header class="site-header"><a class="brand" href={base}>Ao<span class="brand-dot" aria-hidden="true">.</span></a><span class="header-label">PORTFOLIO</span></header><main id="main" class="page-wrap">{title && <><a class="back-link" href={base}>‹ トップに戻る</a><h1 class="page-title">{title}</h1></>}<slot /></main><footer class="site-footer"><a class="brand" href={base}>Ao.</a><nav aria-label="関連リンク"><a href="https://github.com/asojo-02-25">GitHub ↗</a><a href="https://x.com/jo_integralis">X ↗</a></nav><small>© Ao</small></footer></body></html>